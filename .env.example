# Copy this file to .env and fill in what you need. .env is gitignored, so
# credentials stay on your machine - never commit real ones.
#
# Everything here is optional. With no .env at all the site still runs: the
# password reset writes its link to storage/mail.log instead of emailing it.

# --- Outgoing mail (password reset) --------------------------------------
# Leave SP_MAIL_HOST unset and nothing is sent.
#
# Gmail needs an App Password, not your normal one - Google account >
# Security > 2-Step Verification > App passwords.
#   SP_MAIL_HOST=smtp.gmail.com
#   SP_MAIL_PORT=587
#   SP_MAIL_ENCRYPTION=tls
#
# Mailtrap is easier for a demo: it catches everything in a web inbox, so no
# real address is ever mailed. Copy the credentials from your inbox settings.
#   SP_MAIL_HOST=sandbox.smtp.mailtrap.io
#   SP_MAIL_PORT=2525
#   SP_MAIL_ENCRYPTION=tls

SP_MAIL_HOST=
SP_MAIL_PORT=587
SP_MAIL_ENCRYPTION=tls
SP_MAIL_USERNAME=
SP_MAIL_PASSWORD=
SP_MAIL_FROM=no-reply@sportsplatform.my
SP_MAIL_FROM_NAME=SportsPlatform

# --- Other overrides ------------------------------------------------------
# Only needed if the site is not reached at the address it works out itself.
# SP_BASE_URL=http://localhost/sportsplatform
